# Caddy reverse proxy configuration for Linkwarden
#
# Caddy automatically handles HTTPS with Let's Encrypt.
# The domain is set via the LW_DOMAIN env variable in docker-compose.yml.
#
# For standalone Caddy (not docker-compose), replace {$DOMAIN} with your domain.

{$DOMAIN} {
	# Upload size for imports (match LW max_upload_mb)
	request_body {
		max_size 50MB
	}

	# Proxy all requests to Linkwarden backend
	reverse_proxy linkwarden:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Health check — no logging
	@health path /health/live /health/ready
	handle @health {
		reverse_proxy linkwarden:3000
		log_skip
	}
}

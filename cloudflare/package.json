{
  "name": "linkdock-cloudflare",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm --prefix ../web run build && wrangler deploy --dry-run",
    "deploy": "npm --prefix ../web run build && node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply linkdock-accounts --local",
    "db:remote": "wrangler d1 migrations apply linkdock-accounts --remote",
    "preflight": "node scripts/preflight.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@cloudflare/vitest-plugin": "^1.4.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.150.0"
  }
}

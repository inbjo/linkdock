{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkdock-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "../web/dist", "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "linkdock-accounts",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "linkdock-files" }],
  "durable_objects": { "bindings": [{ "name": "USER_FILES", "class_name": "UserFiles" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserFiles"] }],
  "vars": {
    "PUBLIC_URL": "http://localhost:8787", "REGISTRATION_ENABLED": "true",
    "MAX_FILE_BYTES": "10485760", "HISTORY_LIMIT": "20"
  },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "ratelimits": [{
    "name": "AUTH_LIMITER", "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }]
}

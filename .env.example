# =============================================================================
# Linkwarden Environment Configuration
# =============================================================================
# Copy to .env and adjust:  cp .env.example .env

# --- Required ---
# 32-byte hex secret for session signing
# Generate with: openssl rand -hex 32
LW_SESSION_SECRET=

# --- Docker Compose ---
# Port to expose on the host (container always uses 3000 internally)
LW_PORT=3000

# Domain name (only needed if using Caddy reverse proxy profile)
LW_DOMAIN=bookmarks.example.com

# --- Security ---
# Set to false if not behind HTTPS reverse proxy
LW_COOKIE_SECURE=true

# Comma-separated allowed CORS origins (empty = allow all)
LW_CORS_ORIGINS=

# --- Logging ---
# Log format: "json" or "text" (default)
LW_LOG_FORMAT=json

# Log level filter
RUST_LOG=info,linkwarden=debug

# --- Advanced (usually no change needed) ---
# LW_LISTEN=0.0.0.0:3000
# LW_DATA_DIR=/data
# LW_DATABASE_URL=sqlite:///data/linkwarden.sqlite3?mode=rwc

# =============================================================================
# Linkdock Environment Configuration
# =============================================================================
# Copy to .env and adjust:  cp .env.example .env

# --- Required ---
# 32-byte hex secret for session signing
# Generate with: openssl rand -hex 32
DOCK_SESSION_SECRET=

# --- Docker Compose ---
# Port to expose on the host (container always uses 3000 internally)
DOCK_PORT=3000

# Domain name (only needed if using Caddy reverse proxy profile)
DOCK_DOMAIN=bookmarks.example.com

# --- Security ---
# Set to false if not behind HTTPS reverse proxy
DOCK_COOKIE_SECURE=true

# Comma-separated allowed CORS origins (empty = allow all)
DOCK_CORS_ORIGINS=

# --- Logging ---
# Log format: "json" or "text" (default)
DOCK_LOG_FORMAT=json

# Log level filter
RUST_LOG=info,linkdock=debug

# --- Advanced (usually no change needed) ---
# DOCK_LISTEN=0.0.0.0:3000
# DOCK_DATA_DIR=/data
# DOCK_DATABASE_URL=sqlite:///data/linkdock.sqlite3?mode=rwc

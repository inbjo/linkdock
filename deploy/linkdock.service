[Unit]
Description=Linkdock Bookmark Service
After=network.target

[Service]
Type=simple
User=linkdock
Group=linkdock
WorkingDirectory=/opt/linkdock
ExecStart=/opt/linkdock/bin/linkdock
Environment=DOCK_LISTEN=127.0.0.1:3000
Environment=DOCK_DATA_DIR=/opt/linkdock/data
Environment=DOCK_LOG_FORMAT=json
Environment=DOCK_SESSION_SECRET=__SET_ME__
# Recommended for a public fresh install; required only by the first account.
Environment=DOCK_SETUP_TOKEN=__SET_ME__
# Set these to the public HTTPS host before enabling Passkey login.
Environment=DOCK_WEBAUTHN_RP_ID=bookmarks.example.com
Environment=DOCK_WEBAUTHN_ORIGIN=https://bookmarks.example.com
Environment=RUST_LOG=info,linkdock=debug
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
